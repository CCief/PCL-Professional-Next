{
  "manifest_version": 3,
  "name": "PCL Professional-Next · Issue 卡片入口",
  "version": "0.1.0",
  "description": "在 PCL-Professional-Next 的 Issues 列表页显示三张淡彩卡片入口：新功能投稿 / 欢迎 / Bug 反馈",
  "content_scripts": [
    {
      "matches": ["https://github.com/CCief/PCL-Professional-Next/issues*"],
      "js": ["content.js"],
      "css": ["cards.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
